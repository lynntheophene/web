---
import client from '@/lib/client'
import { formatDateByTimeZone } from '@/lib/utils'

interface Props {
  class?: string
}

let fetched = null
try {
  const response = await client.api.github['repo-info'][':owner'][
    ':repository'
  ].$get({
    param: {
      owner: 'lynntheophene',
      repository: 'web'
    }
  })
  fetched = response.status === 200 ? await response.json() : null
} catch (err) {
  fetched = null
}

const data = fetched ?? null

const date = data ? new Date(data.pushedAt) : new Date()

const formattedDate = formatDateByTimeZone(date)

const { class: className } = Astro.props
---

{
  data ? (
    <p class:list={['text-xs min-[961px]:self-end', className]}>
      Last updated by lynntheophene <br class='xs:hidden' /> on {formattedDate} UTC+7
    </p>
  ) : (
    // TODO: handle error
    <p>Something went wrong 😔</p>
  )
}
