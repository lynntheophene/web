---
import { formatDateByTimeZone } from '@/lib/utils'
import getLastUpdatedTime from '@/pages/api/_services/github/repoInfo'

interface Props {
  class?: string
}

let data: Awaited<ReturnType<typeof getLastUpdatedTime>> | null = null
try {
  data = await getLastUpdatedTime('lynntheophene', 'web')
} catch (e) {
  data = null
}

if (!data) return

const date = new Date(data.pushedAt)

const formattedDate = formatDateByTimeZone(date)

const { class: className } = Astro.props
---

{
  data ? (
    <p class:list={['text-xs min-[961px]:self-end', className]}>
      Last updated by lynntheophene <br class='xs:hidden' /> on {formattedDate} UTC+7
    </p>
  ) : (
    // TODO: handle error
    <p>Something went wrong 😔</p>
  )
}
