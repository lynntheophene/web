# NPM configuration for optimized performance
# Use these settings if you prefer npm over pnpm

# Speed up installs by preferring online downloads when available
prefer-online=true
fetch-timeout=300000
fetch-retries=3

# Use npm registry mirror for faster downloads (optional)
# registry=https://registry.npmjs.org/

# Reduce package lock churn
package-lock=true
save-exact=true

# Optional: Set audit level to reduce security check overhead
# audit-level=moderate